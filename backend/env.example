# Required for image generation provider in this backend
NANO_BANANA_API_KEY=replace_with_provider_api_key
# Optional model override
NANO_BANANA_MODEL=gemini-2.5-flash-image

# Optional fallback key name supported by backend
GEMINI_API_KEY=

# Requested deployment variables
FLUX_API_KEY=
# Must include a model endpoint path from BFL docs/account (not just the base URL).
# Example shown below; replace with the exact endpoint enabled in your BFL account.
FLUX_API_URL=https://api.bfl.ai/v1/flux-schnell

# Database (optional: moodboard persistence disabled when not set/reachable)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
DB_NAME=taj_x_lovers_ai

# Comma-separated exact frontend origins (no wildcard in production)
CORS_ORIGINS=https://your-frontend-domain.vercel.app
